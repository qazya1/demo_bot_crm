# Copy this file to inf.env and replace placeholders locally.
# Never commit inf.env or production credentials.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bot_crm
MYSQL_PASSWORD=replace-with-local-password
MYSQL_DB=bot_db
MYSQL_POOL_SIZE=10

# Django
DJANGO_SECRET_KEY=replace-with-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram and MAX
BOT_TOKEN=replace-with-telegram-token
MAX_BOT_TOKEN=replace-with-max-token
WEBAPP_URL=http://127.0.0.1:8443
TESTER_TG_IDS=
ADMIN_IDS=
TG_REQUIRED_CHANNEL=
MAX_REQUIRED_CHANNEL_ID=

# OFD
VSE_OFD_USER=
VSE_OFD_PASSWORD=
VSE_OFD_TOKEN=

# AmoCRM (optional legacy integration)
AMO_DOMAIN=
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=
AMO_PIPELINE_ID=0
AMO_TOKENS_FILE=tokens.json

# T-Bank
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=
TINKOFF_MODE=test
TINKOFF_TAXATION=usn_income
TINKOFF_FFD=1.2
TINKOFF_CASHBOX_TOKEN=

# External product pricing
EXTERNAL_OFD_MARKUP_PCT=0
EXTERNAL_SERVICES_MARKUP_PCT=0
EXTERNAL_EDO_MARKUP_PCT=0

# Company and CORS
COMPANY_EMAIL=
COMPANY_INN=
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8443

# Runtime settings
TOKEN_MAX_STALE_DAYS=30
BALANCE_TRESHOLD=0

# Asterisk ARI (optional)
ASTERISK_ENABLED=0
TEST_CALLS=0
ASTERISK_CLIENT_FACTORY=AsteriskClient
ASTERISK_CALL_METHOD=call
ASTERISK_WAIT_METHOD=wait_call_end
ARI_BASE_URL=http://127.0.0.1:8088/ari
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
ARI_USERNAME=
ARI_PASSWORD=
ARI_APP_NAME=bot-crm-call-control
ARI_TRUNK_ENDPOINT=
ARI_DEFAULT_CALLERID=

# Django CRM integration
DJANGO_CRM_ENABLED=0
DJANGO_CRM_TOKEN=
DJANGO_CRM_SALE_URL=http://127.0.0.1:8000/api/sales/
DJANGO_CRM_APPLICATION_URL=http://127.0.0.1:8000/api/applications/
DJANGO_CRM_VERIFICATION_URL=http://127.0.0.1:8000/api/verifications/
DJANGO_CRM_TIMEOUT=10

# Alfa-Bank partner API
ALFABANK_API_KEY=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
ALFABANK_BASE_URL=https://partner.alfabank.ru/public-api/v2
